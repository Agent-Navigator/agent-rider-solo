# Dependencies
node_modules/

# Build output — the main app's dist/ is a build artifact and stays out of git.
# App Builder output is runtime data under AGENT_RIDER_APPS_DIR, not source.
dist/
*.tsbuildinfo

# Guardrail: local Agent Apps must not be staged under the Agent Rider source
# repo. The scaffold template remains tracked as platform documentation.
plugins/*/manifest.json
plugins/*/app/
plugins/*/dist/
plugins/*/scripts/
!plugins/_template/manifest.json
!plugins/_template/dist/
!plugins/_template/dist/**

# Local SQLite persistence (runtime data)
data/

# Local release archives
releases/

# Logs
*.log

# Python runtime artifacts
__pycache__/
*.py[cod]

# Editor / OS
.DS_Store
.vscode/
.idea/

# Claude Code local settings (machine-specific)
.claude/settings.local.json
