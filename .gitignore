# Dependencies
node_modules/

# Build output — the main app's dist/ is a build artifact and stays out of git.
# Agent App plugins are the exception: each plugins/<slug>/dist/ IS committed so
# the app persists without a rebuild (see plugins/AGENTS.md). Re-include the
# plugin dist dir first, then its contents.
dist/
!plugins/*/dist/
!plugins/*/dist/**
*.tsbuildinfo

# Local SQLite persistence (runtime data)
data/

# Local release archives
releases/

# Logs
*.log

# Editor / OS
.DS_Store
.vscode/
.idea/

# Claude Code local settings (machine-specific)
.claude/settings.local.json
